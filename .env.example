# Copy this file to .env and change what you need.
# Every setting is optional. These are the defaults.

# LLM provider: "ollama" or "openai" (any OpenAI-compatible endpoint)
TRIDENT_LLM_PROVIDER=ollama
TRIDENT_LLM_MODEL=llama3.1:8b

# Default: http://localhost:11434 for ollama, https://api.openai.com/v1 for openai
# TRIDENT_LLM_BASE_URL=http://localhost:11434

# Use a different model for the review step (recommended). By default the
# reviewer is the same model as the classifier, so it is a second check, not
# an independent one.
# TRIDENT_REVIEW_MODEL=qwen2.5:7b

# API key for OpenAI-compatible endpoints (OPENAI_API_KEY also works)
# TRIDENT_LLM_API_KEY=

# Ask the endpoint for JSON-only answers. Set to off if your server does not support it.
# TRIDENT_JSON_MODE=on

# Seconds to wait for one model answer
# TRIDENT_LLM_TIMEOUT=60

# Longer texts go to human review (a whole number of at least 1)
# TRIDENT_MAX_INPUT_CHARS=8000

# Write one JSON line per decision (contains the input text, keep it safe)
# TRIDENT_AUDIT_LOG=logs/audit.jsonl

# Extra folder with your own rule packs (*.yaml, *.yml, *.json)
# TRIDENT_PACKS_DIR=my-packs

# Web server address
# TRIDENT_HOST=127.0.0.1
# TRIDENT_PORT=8000

# Host names the web server answers to (comma separated, * for any).
# Other names get HTTP 400, so other web pages can not use a local server.
# TRIDENT_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
